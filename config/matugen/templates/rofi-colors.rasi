/* ─────────────────────────────────────────────
 * Rofi Theme — Generated by Matugen
 * Rounded grid launcher with Material You colors
 * Do NOT edit manually, this file is overwritten
 * ───────────────────────────────────────────── */

* {
    font: "JetBrainsMono Nerd Font 12";

    bg:               {{colors.surface.default.hex}}ee;
    bg-alt:           {{colors.surface_container.default.hex}};
    fg:               {{colors.on_surface.default.hex}};
    fg-alt:           {{colors.on_surface_variant.default.hex}};
    accent:           {{colors.primary.default.hex}};
    on-accent:        {{colors.on_primary.default.hex}};
    accent-container: {{colors.primary_container.default.hex}};
    on-accent-container: {{colors.on_primary_container.default.hex}};
    urgent:           {{colors.error.default.hex}};
    border-color:     {{colors.outline_variant.default.hex}};
    separator-color:  {{colors.outline_variant.default.hex}};

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    width:            680px;
    border-radius:    20px;
    background-color: @bg;
    border:           2px solid;
    border-color:     @border-color;
}

mainbox {
    padding:    16px;
    spacing:    16px;
}

/* ── Search Bar ── */
inputbar {
    padding:          12px 16px;
    spacing:          12px;
    children:         [ icon-search, entry ];
    border-radius:    14px;
    background-color: @bg-alt;
}

icon-search {
    expand:   false;
    filename: "search";
    size:     20px;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg-alt;
}

/* ── App List ── */
listview {
    columns:       2;
    lines:         7;
    spacing:       8px;
    fixed-height:  true;
    fixed-columns: true;
}

element {
    padding:       10px 14px;
    spacing:       12px;
    border-radius: 12px;
}

element normal.normal {
    background-color: transparent;
}

element normal.urgent {
    text-color: @urgent;
}

element normal.active {
    text-color: @accent;
}

element selected.normal {
    background-color: @accent-container;
    text-color:       @on-accent-container;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @on-accent;
}

element selected.active {
    background-color: @accent;
    text-color:       @on-accent;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
}

/* ── Mode Switcher ── */
mode-switcher {
    spacing:    8px;
    padding:    4px 0 0 0;
}

button {
    padding:          8px 24px;
    border-radius:    12px;
    background-color: @bg-alt;
    text-color:       @fg-alt;
    cursor:           pointer;
}

button selected {
    background-color: @accent;
    text-color:       @on-accent;
}

/* ── Message / Error ── */
message {
    border-radius:    12px;
    background-color: @bg-alt;
    padding:          12px;
}

textbox {
    text-color: @fg;
}

/* ── Scrollbar ── */
scrollbar {
    handle-width:  4px;
    handle-color:  @accent;
    border-radius: 4px;
    padding:       0 4px;
}
